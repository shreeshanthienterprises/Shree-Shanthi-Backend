# Copy to .env for local development. NEVER commit real values.
NODE_ENV=development
PORT=3001

# Resend (https://resend.com) - email is sent over HTTPS (port 443)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend, e.g. contact@shreeshanthienterprises.com
EMAIL_FROM=Shree Shanthi Enterprises <contact@shreeshanthienterprises.com>
# Where notifications are delivered (comma-separated for several). Optional.
EMAIL_TO=shreeshanthienterprises@gmail.com

# Comma-separated list of allowed frontend origins (optional)
FRONTEND_URL=https://shreeshanthienterprises.com
